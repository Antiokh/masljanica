---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import songs from '../../data/songs.json';
import games from '../../data/games.json';
import characters from '../../data/characters.json';
import workshops from '../../data/workshops.json';
import parts from '../../data/parts.json';
import ditties from '../../data/ditties.json';
export function getStaticPaths() {
  return ['songs','games','characters','workshops','scenario','ditties'].map(section=>({params:{section}}));
}
const section = Astro.params.section!;
const titles:Record<string,string>={songs:'Песни',games:'Игры',characters:'Персонажи',workshops:'Мастер-классы',scenario:'Сказ',ditties:'Частушки'};
type Entry = {slug:string;title:string;subtitle?:string;image?:string;category?:string};
const sort = (a:Entry,b:Entry)=>a.title.localeCompare(b.title,'ru');
let entries:Entry[] = [];
if(section==='songs') entries=songs.map(x=>({slug:x.slug,title:x.title,subtitle:[x.audio.length?('Аудио ×'+x.audio.length):'',x.video?'Видео':''].filter(Boolean).join(' · ')})).sort(sort);
if(section==='games') entries=games.map(x=>({slug:x.slug,title:x.title,subtitle:[x.audience,x.audio.length?'Аудио':'',x.video?'Видео':''].filter(Boolean).join(' · '),category:x.historical?'Исторические':'Развлекательные'})).sort(sort);
if(section==='characters') entries=characters.filter(x=>x.show).map(x=>({slug:x.slug,title:x.title,subtitle:x.description.split('\n')[0],image:x.image}));
if(section==='workshops') entries=workshops.map(x=>({slug:x.slug,title:x.title,subtitle:[x.host,x.enabled?'':'Уточняется'].filter(Boolean).join(' · ')}));
if(section==='scenario') entries=parts.map(x=>({slug:String(x.number),title:x.title}));
const groups=section==='games'?['Исторические','Развлекательные']:[''];
---
<StarlightPage frontmatter={{title:titles[section],template:'splash'}}>
  {section==='ditties' ? <div>{ditties.map((x,i)=><section><p class="song-lyrics">{x.text}</p>{i<ditties.length-1&&<hr/>}</section>)}</div> : <>
    <div class="catalog-tools"><input id="catalog-search" type="search" placeholder="Поиск…" aria-label="Поиск по разделу"/>{section==='games'&&<select id="catalog-filter" aria-label="Категория"><option value="">Все категории</option>{groups.map(g=><option value={g}>{g}</option>)}</select>}</div>
    <p id="catalog-empty" hidden>Ничего не найдено.</p>
    {groups.map(group=><section class="catalog-group" data-group={group}>{group&&<h2>{group}</h2>}<div class="app-grid">{entries.filter(x=>!group||x.category===group).map(x=><a class="app-card" data-entry data-search={x.title+' '+(x.subtitle||'')} data-category={x.category||''} href={'/'+section+'/'+x.slug+'/'}>{x.image&&<img src={x.image} alt={x.title} loading="lazy"/>}<div><strong>{x.title}</strong>{x.subtitle&&<small>{x.subtitle}</small>}</div></a>)}</div></section>)}
  </>}
</StarlightPage>
<script>
const search=document.querySelector<HTMLInputElement>('#catalog-search');
const filter=document.querySelector<HTMLSelectElement>('#catalog-filter');
function refresh(){
  let count=0;
  document.querySelectorAll<HTMLElement>('[data-entry]').forEach(el=>{
    el.hidden=!(el.dataset.search||'').toLocaleLowerCase('ru').includes((search?.value||'').trim().toLocaleLowerCase('ru'))||!!(filter?.value&&el.dataset.category!==filter.value);
    if(!el.hidden)count++;
  });
  document.querySelectorAll<HTMLElement>('.catalog-group').forEach(g=>{g.hidden=!g.querySelector('[data-entry]:not([hidden])');});
  const empty=document.querySelector<HTMLElement>('#catalog-empty');if(empty)empty.hidden=count>0;
}
search?.addEventListener('input',refresh);filter?.addEventListener('change',refresh);
</script>
