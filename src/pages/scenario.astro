---
import {localize} from '../lib/editorial-i18n.mjs';
const {tx,lp,uiLocale,uiTag}=localize(Astro.url.pathname);
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import StoryLine from '../components/StoryLine.astro';
import CharacterGallery from '../components/CharacterGallery.astro';
import CharacterDialog from '../components/CharacterDialog.astro';
import GameIcon from '../components/GameIcon.astro';
import characters from '../data/characters.json';
import characterArchive from '../data/character-archive.json';
import audioArchive from '../data/audio-archive.json';
import scenario from '../data/scenario.json';
import parts from '../data/parts.json';
import songs from '../data/songs.json';
import FestivalIntro from '../components/FestivalIntro.astro';
import {existsSync} from 'node:fs';
const portraits=characterArchive.files as Record<string,{path:string;width:number;height:number}>;
const files=audioArchive.files as Record<string,{path:string;duration:number}>;
const people=characters.map(x=>{const p=portraits[x.image];return {...x,title:tx(x.title),description:tx(x.description),src:p?.path&&/^\/media\/characters\/[a-f0-9]+\.webp$/.test(p.path)&&existsSync(process.cwd()+'/public'+p.path)?p.path:''};});
const actors=new Map(people.map(p=>[p.id,p]));
const linked=new Map(songs.map(s=>[s.id,{...s,title:tx(s.title)}]));
const localTrack=(url:string)=>{const t=files[url];if(!t||!/^\/media\/audio\/[a-z0-9_-]+\.mp3$/.test(t.path)||!existsSync(process.cwd()+'/public'+t.path))throw Error('Missing scenario audio '+url);return {src:t.path,duration:t.duration};};
const ordered=[...scenario].sort((a,b)=>a.order-b.order);
const labels:Record<number,string>={1:tx('Часть первая'),2:tx('Часть вторая'),3:tx('Завершение')};
const numeral:Record<number,string>={1:'I',2:'II',3:'III'};
const stageOrders=new Set([3,26,38,45,49]);
// Only explicitly identified directions are italicized. Quiz answers in brackets remain spoken text.
const annotatedOrders=new Set([4,19,21]);
const segments=(order:number,text:string)=>annotatedOrders.has(order)?text.split(/(\([^()]*\))/g).filter(Boolean).map(t=>({text:t,stage:t.startsWith('(')&&t.endsWith(')')})):[{text,stage:false}];
const prepared=ordered.map(row=>{const actor=actors.get(row.actor),song=row.song?linked.get(row.song):undefined;if(!actor)throw Error('Missing scenario actor '+row.order);return {row,actor,song,tracks:song?song.audio.map(localTrack):[],stage:stageOrders.has(row.order),segments:segments(row.order,tx(row.text))};});
---
<StarlightPage lang={uiTag} frontmatter={{title:tx('Сказ'),template:'splash',description:tx('История Масляницы и театральный сказ нашего праздника.')}}>
 <div class="story-book" data-character-gallery data-story-book>
  <FestivalIntro />
  <section id="story-characters" class="story-characters" aria-labelledby="story-characters-title">
    <h2 id="story-characters-title">{tx("Герои нашего сказа")}</h2>
    <CharacterGallery />
  </section>
  <section class="story-scenario" aria-labelledby="story-scenario-title">
    <h2 id="story-scenario-title">{tx("Наш масляничный сказ")}</h2>
    <audio id="story-audio" hidden preload="none"></audio>
    <div class="story-parts">
      {[...parts].sort((a,b)=>a.number-b.number).map(part=><details class="story-part" id={'part-'+part.number} open={part.number===1}>
        <summary><span class="story-part-number">{numeral[part.number]||part.number}</span><strong>{labels[part.number]||part.title}</strong><GameIcon name="chevron" class="story-chevron"/></summary>
        <div class="story-lines">
          {prepared.filter(x=>x.row.part===part.number).map(x=><StoryLine {...x}/>)}
        </div>
      </details>)}
    </div>
  </section>
  {people.map(x=><CharacterDialog person={x}/>)}
 </div>
</StarlightPage>
