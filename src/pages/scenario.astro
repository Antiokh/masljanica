---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import CharacterDialog from '../components/CharacterDialog.astro';
import GameIcon from '../components/GameIcon.astro';
import characters from '../data/characters.json';
import characterArchive from '../data/character-archive.json';
import audioArchive from '../data/audio-archive.json';
import scenario from '../data/scenario.json';
import parts from '../data/parts.json';
import songs from '../data/songs.json';
import MarkdownIt from 'markdown-it';
import {existsSync,readFileSync} from 'node:fs';
const md=new MarkdownIt({html:false});
const history=readFileSync(new URL('../data/maslyanica-history.md',import.meta.url),'utf8').replace(/<!--[\s\S]*?-->/g,'').trim();
const portraits=characterArchive.files as Record<string,{path:string;width:number;height:number}>;
const files=audioArchive.files as Record<string,{path:string;duration:number}>;
const people=characters.map(x=>{const p=portraits[x.image];return {...x,src:p?.path&&/^\/media\/characters\/[a-f0-9]+\.webp$/.test(p.path)&&existsSync(process.cwd()+'/public'+p.path)?p.path:''};});
const actors=new Map(people.map(p=>[p.id,p]));
const linked=new Map(songs.map(s=>[s.id,s]));
const localTrack=(url:string)=>{const t=files[url];if(!t||!/^\/media\/audio\/[a-z0-9_-]+\.mp3$/.test(t.path)||!existsSync(process.cwd()+'/public'+t.path))throw Error('Missing scenario audio '+url);return {src:t.path,duration:t.duration};};
const ordered=[...scenario].sort((a,b)=>a.order-b.order);
const labels:Record<number,string>={1:'Часть первая',2:'Часть вторая',3:'Завершение'};
const numeral:Record<number,string>={1:'I',2:'II',3:'III'};
const stageOrders=new Set([3,26,38,45,49]);
// Only explicitly identified directions are italicized. Quiz answers in brackets remain spoken text.
const annotatedOrders=new Set([4,19,21]);
const segments=(order:number,text:string)=>annotatedOrders.has(order)?text.split(/(\([^()]*\))/g).filter(Boolean).map(t=>({text:t,stage:t.startsWith('(')&&t.endsWith(')')})):[{text,stage:false}];
const format=(n:number)=>Math.floor(n/60)+':'+String(Math.floor(n%60)).padStart(2,'0');
---
<StarlightPage frontmatter={{title:'Сказ',template:'splash',description:'История Масляницы и театральный сказ нашего праздника.'}}>
 <div class="story-book" data-character-gallery data-story-book>
  <section class="story-history" aria-labelledby="story-history-title">
    <div class="story-history-art" aria-hidden="true"><svg viewBox="0 0 64 64"><g stroke="#B5232C" stroke-width="3" stroke-linecap="round">{Array.from({length:12},(_,i)=>i*Math.PI/6).map(a=><path d={`M${32+21*Math.sin(a)} ${32+21*Math.cos(a)} L${32+27*Math.sin(a)} ${32+27*Math.cos(a)}`}/>)}</g><circle cx="32" cy="32" r="16" fill="#E9B44C"/><path d="M24 32h.01M40 32h.01M27 39q5 4 10 0" stroke="#794831" stroke-width="2.5" stroke-linecap="round" fill="none"/></svg></div>
    <h2 id="story-history-title">Что такое Масляница?</h2>
    {history?<details class="story-history-details"><summary>История праздника и народные традиции <GameIcon name="chevron"/></summary><div class="story-history-content" set:html={md.render(history)}/></details>:<p class="story-history-placeholder">История праздника и народные традиции. Текст готовится.</p>}
  </section>
  <section class="story-scenario" aria-labelledby="story-scenario-title">
    <h2 id="story-scenario-title">Наш масляничный сказ</h2>
    <audio id="story-audio" hidden preload="none"></audio>
    <div class="story-parts">
      {[...parts].sort((a,b)=>a.number-b.number).map(part=><details class="story-part" id={'part-'+part.number} open={part.number===1}>
        <summary><span class="story-part-number">{numeral[part.number]||part.number}</span><strong>{labels[part.number]||part.title}</strong><GameIcon name="chevron" class="story-chevron"/></summary>
        <div class="story-lines">
          {ordered.filter(x=>x.part===part.number).map(row=>{
            const actor=actors.get(row.actor),song=row.song?linked.get(row.song):undefined;
            if(!actor)throw Error('Missing scenario actor '+row.order);
            const tracks=song?song.audio.map(localTrack):[];
            const stage=stageOrders.has(row.order);
            return <article id={'replica-'+row.order} data-story-line={row.order} data-role={actor.slug} class:list={['story-line',{'story-stage':stage,'story-song':!!song}]}>
              {stage?<><div class="story-stage-label"><GameIcon name="game"/><span>Ремарка · {actor.title}</span></div><p class="story-original">{row.text}</p></>:<>
                <div class="story-portrait">
                  <button type="button" class="story-portrait-button" data-character-open={actor.slug} aria-haspopup="dialog" aria-controls={'character-'+actor.slug} aria-label={'О персонаже: '+actor.title}>
                    {actor.src?<img src={actor.src} width="64" height="64" alt="" loading="lazy" decoding="async"/>:<span>{actor.title.slice(0,1)}</span>}
                  </button>
                </div>
                <div class="story-replica">
                  <strong class="story-role">{actor.title}</strong>
                  <p class="story-original">{segments(row.order,row.text).map(t=>t.stage?<em>{t.text}</em>:t.text)}</p>
                  {song&&tracks.length>0&&<div class="story-music" data-story-music={row.order} data-tracks={JSON.stringify(tracks)}>
                    <div class="story-music-top">
                      <button type="button" class="story-play" data-story-action="toggle" data-playing="false" aria-label={'Воспроизвести: '+song.title}>
                        <svg viewBox="0 0 40 40" class="story-ring" aria-hidden="true"><circle cx="20" cy="20" r="17" class="story-ring-track"/><circle cx="20" cy="20" r="17" pathLength="100" class="story-ring-progress"/></svg>
                        <svg viewBox="0 0 24 24" class="story-play-icon" fill="currentColor" aria-hidden="true"><path d="M8 5v14l12-7z"/></svg><svg viewBox="0 0 24 24" class="story-pause-icon" fill="currentColor" aria-hidden="true"><path d="M7 5h4v14H7zm6 0h4v14h-4z"/></svg>
                      </button>
                      <div class="story-music-main"><strong>{song.title}</strong><div class="story-seek-row"><input type="range" class="story-seek" min="0" max="1000" step="1" value="0" aria-label={'Перемотка: '+song.title}/><span class="story-time">{format(tracks[0].duration)}</span></div></div>
                    </div>
                    {tracks.length>1&&<div class="story-variants" role="group" aria-label="Варианты исполнения">{tracks.map((_,i)=><button type="button" data-story-variant={i} aria-pressed={i===0?'true':'false'} aria-label={'Запись '+(i+1)}>{i+1}</button>)}</div>}
                    <a class="story-song-link" href={'/songs/#'+song.slug}>Текст в песеннике</a>
                    <p class="story-music-error" role="status" hidden></p>
                  </div>}
                </div>
              </>}
            </article>;
          })}
        </div>
      </details>)}
    </div>
  </section>
  {people.filter(x=>ordered.some(row=>row.actor===x.id)).map(x=><CharacterDialog person={x}/>)}
 </div>
</StarlightPage>
