---
import {localize} from '../../public/i18n.mjs';
const {tx,lp,uiLocale,uiTag}=localize(Astro.url.pathname);
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import songs from '../data/songs.json';
import meanings from '../data/song-meanings.json';
import archive from '../data/audio-archive.json';
import { existsSync } from 'node:fs';
const files = archive.files as Record<string,{path:string;duration:number}>;
const ordered = songs.map(s=>({...s,title:tx(s.title),originalTitle:s.title})).sort((a,b)=>a.title.localeCompare(b.title,uiTag));
function localTrack(url:string) {
  const track=files[url];
  if(!track || !/^\/media\/audio\/[a-z0-9_-]+\.mp3$/.test(track.path) || !existsSync(process.cwd()+'/public'+track.path)) {
    throw new Error('Song audio missing from the local archive: '+url);
  }
  return {src:track.path,duration:track.duration};
}
function videoURL(value:string) {
  try {
    const u=new URL(value);
    if(u.protocol!=='https:' && u.protocol!=='http:')return null;
    const host=u.hostname.replace(/^www\./,'');
    const id=host==='youtu.be'?u.pathname.slice(1):host==='youtube.com'?u.searchParams.get('v'):null;
    return id && /^[\w-]{11}$/.test(id) ? {link:u.href,embed:'https://www.youtube-nocookie.com/embed/'+id} : {link:u.href,embed:null};
  }catch{return null;}
}
const duration=(seconds:number)=>Math.floor(seconds/60)+':'+String(Math.floor(seconds%60)).padStart(2,'0');
---
<StarlightPage lang={uiTag} frontmatter={{title:tx('Песни'),template:'splash',description:tx('Песенник Масляницы: слушайте записи и раскрывайте тексты прямо в списке.')}}>
  <div class="catalog-tools"><input id="catalog-search" type="search" placeholder={tx("Найти песню…")} aria-label={tx("Поиск по песням")}/></div>
  <p id="catalog-empty" hidden>{tx("Ничего не найдено.")}</p>
  <audio id="song-player-audio" preload="none" hidden></audio>
  <section id="song-player" class="playlist-panel" aria-label={tx("Общий плейлист")}>
    <div class="playlist-heading">
      <div class="playlist-caption">{tx('Плейлист · ')}{ordered.reduce((n,s)=>n+s.audio.length,0)}{tx(' записи')}</div>
      <span id="playlist-position">1 / {ordered.reduce((n,s)=>n+s.audio.length,0)}</span>
    </div>
    <div class="playlist-controls">
      <button type="button" class="playlist-step" data-playlist-action="previous" aria-label={tx("Предыдущая запись")} disabled><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6 5h2v14H6zm12 0L9 12l9 7z"/></svg></button>
      <button type="button" class="playlist-play" data-playlist-action="toggle" data-playing="false" aria-label={tx("Воспроизвести плейлист")}>
        <span class="song-disc" aria-hidden="true">
          <svg class="song-ring" viewBox="0 0 40 40"><circle cx="20" cy="20" r="18" class="song-ring-track"/><circle cx="20" cy="20" r="18" pathLength="100" class="song-ring-progress"/></svg>
          <svg class="song-play-icon" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5.5v13l11-6.5z"/></svg>
          <svg class="song-pause-icon" viewBox="0 0 24 24" fill="currentColor"><rect x="7" y="5.5" width="4" height="13" rx="1"/><rect x="13" y="5.5" width="4" height="13" rx="1"/></svg>
        </span>
      </button>
      <div class="playlist-track">
        <strong id="playlist-title">{ordered[0]?.title}</strong>
        <span id="playlist-variant">{tx("Запись 1")}</span>
        <div class="playlist-seek-row">
          <input id="playlist-seek" class="song-seek" type="range" min="0" max="1000" step="1" value="0" aria-label={tx("Перемотка текущей записи")}/>
          <span id="playlist-time">0:00 / {duration(localTrack(ordered[0].audio[0]).duration)}</span>
        </div>
      </div>
      <button type="button" class="playlist-step" data-playlist-action="next" aria-label={tx("Следующая запись")}><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M16 5h2v14h-2zM6 5l9 7-9 7z"/></svg></button>
    </div>
    <p id="song-player-error" role="status" hidden></p>
  </section>
  <div class="catalog-master" data-catalog-master="songs">
    <nav class="catalog-master-nav" data-master-nav aria-label={tx("Список песен")} hidden></nav>
    <div class="catalog-master-content" data-master-content>
  <section class="catalog-group song-list" aria-label={tx("Песенник")}>
    {ordered.map(song=>{
      const tracks=song.audio.map(localTrack);
      const video=videoURL(song.video);
      return (
        <article id={song.slug} class="song-row" data-entry data-search={song.title+' '+song.originalTitle+' '+song.lyrics} data-song={song.title} data-tracks={JSON.stringify(tracks)}>
          <button type="button" class="song-play" aria-label={tx('Воспроизвести: ')+song.title} data-playing="false" disabled={tracks.length===0}>
            <span class="song-disc" aria-hidden="true">
              <svg class="song-ring" viewBox="0 0 40 40"><circle cx="20" cy="20" r="18" class="song-ring-track"/><circle cx="20" cy="20" r="18" pathLength="100" class="song-ring-progress"/></svg>
              <svg class="song-play-icon" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5.5v13l11-6.5z"/></svg>
              <svg class="song-pause-icon" viewBox="0 0 24 24" fill="currentColor"><rect x="7" y="5.5" width="4" height="13" rx="1"/><rect x="13" y="5.5" width="4" height="13" rx="1"/></svg>
            </span>
          </button>
          <details class="song-details">
            <summary>
              <span class="song-heading">
                <strong>{song.title}</strong>
                <small>{tracks.length>1?tracks.length+tx(' варианта исполнения'):tracks.length===1&&tracks[0].duration?duration(tracks[0].duration):''}{video && <span data-online-only hidden>{tracks.length>1||(tracks.length===1&&tracks[0].duration)?' · ':''}{tx('Видео')}</span>}</small>
              </span>
              <svg class="song-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
            </summary>
            <div class="song-body">
              {tracks.length>0 && (
                <div class="song-media">
                  <div class="song-variants" role="group" aria-label={tx('Записи: ')+song.title}>
                    {tracks.map((track,i)=>(
                      <div class="song-variant" data-src={track.src} data-variant={i} data-selected={String(i===0)} data-playing="false">
                        <button type="button" class="song-variant-toggle" aria-pressed={i===0?'true':'false'} aria-label={tx('Запись ')+(i+1)+': '+song.title}>
                        <span class="song-disc" aria-hidden="true">
                          <svg class="song-ring" viewBox="0 0 40 40"><circle cx="20" cy="20" r="18" class="song-ring-track"/><circle cx="20" cy="20" r="18" pathLength="100" class="song-ring-progress"/></svg>
                          <span class="song-track-number">{i+1}</span>
                          <svg class="song-play-icon" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5.5v13l11-6.5z"/></svg>
                          <svg class="song-pause-icon" viewBox="0 0 24 24" fill="currentColor"><rect x="7" y="5.5" width="4" height="13" rx="1"/><rect x="13" y="5.5" width="4" height="13" rx="1"/></svg>
                        </span>
                        </button>
                        <div class="song-variant-info" inert={i!==0}>
                          <div class="song-variant-meta"><span class="song-variant-title">{tx('Запись ')}{i+1}</span><span class="song-variant-time" data-duration={track.duration}>{duration(track.duration)}</span></div>
                          <input class="song-seek" type="range" min="0" max="1000" step="1" value="0" aria-label={tx('Перемотка: ')+song.title+', запись '+(i+1)} aria-valuetext={'0:00 / '+duration(track.duration)}/>
                        </div>
                      </div>
                    ))}
                  </div>
                  <noscript>{tracks.map((track,i)=><p><a href={track.src}>{tx('Запись ')}{i+1}</a></p>)}</noscript>
                </div>
              )}
              {song.lyrics && <>{uiLocale!=='ru'&&meanings[song.slug]?.[uiLocale]&&<p>{meanings[song.slug][uiLocale]}</p>}{uiLocale!=='ru'&&<p>{tx('Оригинал на русском языке')}</p>}<div class="song-lyrics" lang="ru">{song.lyrics}</div></>}
              <p><a href={lp('/songs/'+song.slug+'/')}>{tx("Открыть отдельную страницу песни")}</a></p>
              {video && <div class="song-video" data-online-only data-external-embed data-embed-src={video.embed||undefined} data-embed-mode="manual" hidden>
                <h3>{tx("Видео")}</h3>
                {video.embed && <button class="offline-delete song-video-load" type="button" data-embed-load>{tx("Смотреть видео")}</button>}
                <div data-embed-surface hidden></div>
                <a href={video.link} target="_blank" rel="noopener noreferrer">{tx("Открыть видео в новой вкладке")}</a>
              </div>}
            </div>
          </details>
        </article>
      );
    })}
  </section>
    </div>
  </div>
</StarlightPage>
