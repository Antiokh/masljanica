---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import DittyCard from '../components/DittyCard.astro';
import ditties from '../data/ditties.json';
import folklore from '../data/ditties-folk.json';
const sources=folklore.sources as Record<string,{title:string;collection:string;short:string;url:string}>;
const own=ditties.map(item=>({...item,category:'own',credit:'Антон Назаров · Белград'}));
const folk=folklore.items.map(item=>({...item,credit:[item.author||'Автор неизвестен',item.performer?'исп. '+item.performer:'',sources[item.source].short].filter(Boolean).join(' · '),source:sources[item.source]}));
const items=[...own,...folk];
const filters=[{id:'',label:'Все'},{id:'own',label:'Наши'},{id:'folk',label:'Народные'},{id:'bawdy',label:'Заветные'},{id:'political',label:'Политические'}];
---
<StarlightPage frontmatter={{title:'Частушки',template:'splash',description:'Авторские и народные частушки, с указанием источников.'}}>
  <div class="ditties-page">
    <p class="ditties-intro">Ну какая же Масляница без частушек? Местами — крепкое словцо.</p>
    <div class="catalog-tools"><input id="catalog-search" type="search" placeholder="Найти частушку…" aria-label="Поиск частушек"/></div>
    <div class="ditty-filters" role="group" aria-label="Виды частушек">
      {filters.map(f=><button type="button" data-ditty-filter data-value={f.id} aria-pressed={f.id===''?'true':'false'}>{f.label}</button>)}
    </div>
    <p class="ditty-count" id="ditty-count" aria-live="polite">Найдено: {items.length}</p>
    <p id="catalog-empty" hidden>Ничего не найдено.</p>
    <div class="ditties-grid">
      {items.map(item=><DittyCard item={item}/>)}
    </div>
    <details class="ditty-sources">
      <summary>О сборниках и источниках</summary>
      <p>Народные тексты приводятся по фольклорным подборкам. Номера относятся к соответствующим публикациям. Автор, исполнитель и собиратель — разные роли. Даты отдельных записей из собрания Волкова не установлены.</p>
      {Object.values(sources).map(source=><div class="ditty-source"><strong>{source.title}</strong><p>{source.collection}</p><a href={source.url} data-online-only hidden target="_blank" rel="noopener noreferrer">Открыть источник ↗</a></div>)}
    </details>
  </div>
</StarlightPage>
<style>
  .ditties-page { display:grid; gap:.65rem; min-width:0; }
  .ditties-page :global([hidden]) { display:none!important; }
  .ditties-intro { color:var(--sl-color-gray-3); font-size:.9rem; margin:0!important; }
  .ditties-page .catalog-tools { margin:0!important; }
  .ditty-filters { display:flex; flex-wrap:wrap; gap:.4rem; margin:0!important; }
  .ditty-filters button { font:inherit; font-size:.8rem; line-height:1.3; padding:.45rem .75rem; border:1px solid var(--festival-control-border); border-radius:999px; color:var(--sl-color-text); background:var(--sl-color-bg); cursor:pointer; margin:0!important; }
  .ditty-filters button[aria-pressed=true] { background:var(--festival-selected); color:#fff; border-color:var(--festival-selected); }
  .ditty-count { color:var(--sl-color-gray-3); font-size:.8rem; margin:0!important; }
  .ditties-grid { display:grid; grid-template-columns:minmax(0,1fr); align-items:start; gap:.55rem; margin:0!important; }
  .ditties-grid :global(.ditty-card) { display:flex; flex-direction:column; justify-content:space-between; gap:.55rem; margin:0!important; min-width:0; padding:.9rem 1rem; border:1px solid var(--sl-color-gray-5); border-radius:.8rem; background:var(--festival-surface); }
  .ditties-grid :global(.ditty-text) { white-space:pre-wrap; overflow-wrap:anywhere; font-size:1rem; line-height:1.55; margin:0!important; }
  .ditties-grid :global(.ditty-credit) { display:flex; flex-wrap:wrap; justify-content:space-between; align-items:baseline; gap:.25rem .5rem; color:var(--sl-color-gray-3); font-size:.72rem; margin:0!important; }
  .ditties-grid :global(.ditty-credit a) { color:inherit; margin:0!important; }
  .ditty-sources { font-size:.85rem; }
  .ditty-source { padding:.55rem 0; border-top:1px solid var(--sl-color-gray-5); }
  .ditty-source p { margin:.2rem 0!important; }
  @media(min-width:48rem) { .ditties-grid { grid-template-columns:repeat(2,minmax(0,1fr)); } }
</style>
