---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import ditties from '../data/ditties.json';
---
<StarlightPage frontmatter={{title:'Частушки',template:'splash'}}>
  <div class="ditties-list">
    {ditties.map(item => (
      <section><p class="song-lyrics">{item.text}</p></section>
    ))}
  </div>
</StarlightPage>
