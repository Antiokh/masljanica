---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import ditties from '../data/ditties.json';
---
<StarlightPage frontmatter={{title:'Частушки',template:'splash',description:'Масляничные частушки и немного народного юмора.'}}>
  <div class="ditties-page">
    <p class="ditties-intro">Ну какая же Масляница без частушек? Местами — крепкое словцо.</p>
    <div class="ditties-grid">
      {ditties.map(ditty=><article class="ditty-card"><p>{ditty.text}</p></article>)}
    </div>
  </div>
</StarlightPage>
<style>
  .ditties-page { display:grid; gap:.85rem; min-width:0; }
  .ditties-intro { color:var(--sl-color-gray-3); font-size:.9rem; margin:0!important; }
  .ditties-grid { display:grid; grid-template-columns:minmax(0,1fr); gap:.55rem; margin:0!important; }
  .ditty-card { margin:0!important; min-width:0; padding:.9rem 1rem; border:1px solid var(--sl-color-gray-5); border-radius:.8rem; background:var(--festival-surface); }
  .ditty-card p { white-space:pre-wrap; overflow-wrap:anywhere; font-size:1rem; line-height:1.55; margin:0!important; }
  @media(min-width:48rem) { .ditties-grid { grid-template-columns:repeat(2,minmax(0,1fr)); } }
</style>
