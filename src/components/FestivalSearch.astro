---
---
<button class="festival-search-trigger" type="button" data-search-open aria-haspopup="dialog" aria-controls="festival-search-dialog" aria-label="Поиск по Маслянице" aria-keyshortcuts="Control+K Meta+K">
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/></svg>
  <span>Поиск</span>
</button>
<dialog id="festival-search-dialog" class="festival-search-dialog" aria-labelledby="festival-search-title" data-pagefind-ignore>
  <div class="festival-search-frame">
    <div class="festival-search-heading">
      <h2 id="festival-search-title">Поиск по Маслянице</h2>
      <button type="button" data-search-close aria-label="Закрыть поиск"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"/></svg></button>
    </div>
    <input id="festival-search-input" type="search" placeholder="Песни, игры, сказ…" aria-label="Поиск по всем материалам" autocomplete="off" autofocus/>
    <p id="festival-search-status" role="status" aria-live="polite">Введите слово или фразу.</p>
    <ul id="festival-search-results" aria-label="Результаты поиска"></ul>
    <button type="button" data-search-more hidden>Показать ещё</button>
  </div>
</dialog>
