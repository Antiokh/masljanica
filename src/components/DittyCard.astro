---
const {item}=Astro.props;
---
<article class="ditty-card" data-entry data-category={item.category} data-search={[item.text,item.credit,item.source?.title,item.source?.collection].filter(Boolean).join(' ')}>
  <p class="ditty-text">{item.text}</p>
  <footer class="ditty-credit">
    <span>{item.credit}{item.number?' · № '+item.number:''}</span>
    {item.source && <a href={item.source.url} data-online-only hidden target="_blank" rel="noopener noreferrer" title={item.source.collection} aria-label={'Источник: '+item.source.title+', № '+item.number}>Источник ↗</a>}
  </footer>
</article>
