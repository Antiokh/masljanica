---
import {localize,localizedPath} from '../../public/i18n.mjs';
const {tx,lp,uiLocale,uiTag,basePath}=localize(Astro.url.pathname);
import PwaStatus from './PwaStatus.astro';
import Search from './FestivalSearch.astro';
import ThemeSelect from '@astrojs/starlight/components/ThemeSelect.astro';
import ThemeSwitch from './ThemeSwitch.astro';
const path = decodeURI(basePath);
const links = [
  {href:'/',title:tx('Избушка'),icon:'M3 10 12 3l9 7v10a1 1 0 0 1-1 1h-5v-8H9v8H4a1 1 0 0 1-1-1z'},
  {href:'/songs/',title:tx('Песни'),icon:'M9 18V5l12-2v13M9 18a3 3 0 1 1-3-3h3m12 1a3 3 0 1 1-3-3h3'},
  {href:'/games/',title:tx('Игры'),icon:'M7 3h10a4 4 0 0 1 4 4v10a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4V7a4 4 0 0 1 4-4z M7.5 7.5h.01M16.5 7.5h.01M12 12h.01M7.5 16.5h.01M16.5 16.5h.01'}
];
const more = [{href:'/scenario/',title:tx('Сказ')},{href:'/workshops/',title:tx('Мастера')},{href:'/pancakes/',title:tx('Блины')},{href:'/history/',title:tx('История')}];
const active = (href:string) => href==='/'?path==='/':path.startsWith(href);
const moreActive = more.some(link=>active(link.href));
---
<div class="app-header">
  <PwaStatus />
  <div class="header-navigation">
  <nav class="app-nav" aria-label={tx("Основная навигация")}>
    {links.map(link=>(
      <a data-astro-prefetch="hover" href={lp(link.href)} aria-current={active(link.href)?'page':undefined}>
        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={link.icon}/></svg>
        <span>{link.title}</span>
      </a>
    ))}
    <details class="more-menu" data-active={moreActive? 'true':undefined}>
      <summary>
        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
        <span>{tx("Ещё")}</span>
      </summary>
      <div class="more-links"><div class="pwa-mobile-status"><button type="button" data-pwa-menu-trigger popovertarget="festival-pwa-menu" aria-controls="festival-pwa-menu" aria-expanded="false"><span data-pwa-value="compact">{tx("Офлайн-копия")}</span><span aria-hidden="true">⋮</span></button><progress max="100" value="0" data-pwa-bar data-pwa-progress hidden aria-label={tx("Прогресс офлайн-загрузки")}></progress></div><div class="telegram-menu-tools"><button type="button" data-search-open aria-haspopup="dialog" aria-controls="festival-search-dialog">{tx("Поиск")}</button><label><span>{tx("Тема")}</span><select data-telegram-theme aria-label={tx("Цветовая тема")}><option value="auto">Telegram</option><option value="light">{tx("Светлая")}</option><option value="dark">{tx("Тёмная")}</option></select></label></div><div class="app-language-links" aria-label={tx('Язык')}>{['ru','sr','en'].filter(x=>x!==uiLocale).map(x=><a href={localizedPath(basePath,x)} lang={x==='sr'?'sr-Latn':x} data-language-choice={x} data-astro-reload>{x==='ru'?'Русский':x==='sr'?'Srpski':'English'}</a>)}</div>{more.map(link=><a data-astro-prefetch="hover" href={lp(link.href)} aria-current={active(link.href)?'page':undefined}>{link.title}</a>)}</div>
    </details>
  </nav>
  <div class="header-search"><Search /></div>
  </div>
  <div class="header-actions"><div class="desktop-theme-control"><ThemeSwitch /></div><div class="mobile-theme-control"><ThemeSelect /></div></div>
</div>
<div class="pwa-nav-progress" data-pwa-nav-progress hidden><progress max="100" value="0" data-pwa-bar aria-label={tx("Прогресс офлайн-загрузки")}></progress></div>

<div class="pwa-notice" id="pwa-storage-notice" hidden role="region" aria-label={tx("Локальное хранилище")}>
  <p>{tx("Приложение использует локальное хранилище для темы и офлайн-материалов. Полную копию можно скачать и удалить в меню состояния приложения (значок солнца или «Офлайн-копия» в меню «Ещё»).")}</p>
  <button class="app-button" id="pwa-storage-accept">{tx("Понятно")}</button>
</div>
<div class="pwa-notice" id="pwa-offer" hidden role="region" aria-label={tx("Приложение")}>
  <p id="pwa-offer-message"></p>
  <div class="pwa-notice-actions"><button class="app-button" id="pwa-offer-action">{tx("Скачать")}</button><button class="offline-delete" id="pwa-offer-dismiss">{tx("Не сейчас")}</button></div>
</div>
