---
import PwaStatus from './PwaStatus.astro';
import Search from '@astrojs/starlight/components/Search.astro';
import ThemeSelect from '@astrojs/starlight/components/ThemeSelect.astro';
import ThemeSwitch from './ThemeSwitch.astro';
const path = decodeURI(Astro.url.pathname);
const links = [
  {href:'/',title:'Избушка',icon:'M3 10 12 3l9 7v10a1 1 0 0 1-1 1h-5v-8H9v8H4a1 1 0 0 1-1-1z'},
  {href:'/songs/',title:'Песни',icon:'M9 18V5l12-2v13M9 18a3 3 0 1 1-3-3h3m12 1a3 3 0 1 1-3-3h3'},
  {href:'/games/',title:'Игры',icon:'M7 3h10a4 4 0 0 1 4 4v10a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4V7a4 4 0 0 1 4-4z M7.5 7.5h.01M16.5 7.5h.01M12 12h.01M7.5 16.5h.01M16.5 16.5h.01'}
];
const more = [{href:'/scenario/',title:'Сказ'},{href:'/characters/',title:'Персонажи'},{href:'/workshops/',title:'Мастера'},{href:'/offline/',title:'Офлайн'}];
const active = (href:string) => href==='/'?path==='/':path.startsWith(href);
const moreActive = more.some(link=>active(link.href));
---
<div class="app-header">
  <PwaStatus />
  <nav class="app-nav" aria-label="Основная навигация">
    {links.map(link=>(
      <a data-astro-prefetch="hover" href={link.href} aria-current={active(link.href)?'page':undefined}>
        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={link.icon}/></svg>
        <span>{link.title}</span>
      </a>
    ))}
    <details class="more-menu" data-active={moreActive? 'true':undefined}>
      <summary>
        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
        <span>Ещё</span>
      </summary>
      <div class="more-links"><div class="pwa-mobile-status"><button type="button" data-pwa-menu-trigger popovertarget="festival-pwa-menu" aria-controls="festival-pwa-menu" aria-expanded="false"><span data-pwa-value="compact">Офлайн-копия</span><span aria-hidden="true">⋮</span></button><progress max="100" value="0" data-pwa-bar data-pwa-progress hidden aria-label="Прогресс офлайн-загрузки"></progress></div>{more.map(link=><a data-astro-prefetch="hover" href={link.href} aria-current={active(link.href)?'page':undefined}>{link.title}</a>)}</div>
    </details>
  </nav>
  <div class="header-actions"><Search /><div class="desktop-theme-control"><ThemeSwitch /></div><div class="mobile-theme-control"><ThemeSelect /></div></div>
  <div class="pwa-nav-progress" data-pwa-nav-progress hidden><progress max="100" value="0" data-pwa-bar aria-label="Прогресс офлайн-загрузки"></progress></div>
</div>

<div class="pwa-notice" id="pwa-storage-notice" hidden role="region" aria-label="Локальное хранилище">
  <p>Приложение использует локальное хранилище для темы и офлайн-материалов. Полную копию можно скачать и удалить в разделе «Офлайн».</p>
  <button class="app-button" id="pwa-storage-accept">Понятно</button>
</div>
<div class="pwa-notice" id="pwa-offer" hidden role="region" aria-label="Приложение">
  <p id="pwa-offer-message"></p>
  <div class="pwa-notice-actions"><button class="app-button" id="pwa-offer-action">Скачать</button><button class="offline-delete" id="pwa-offer-dismiss">Не сейчас</button></div>
</div>
