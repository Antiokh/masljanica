---
import Head from '@astrojs/starlight/components/Head.astro';
import { ClientRouter } from 'astro:transitions';
import { site,brand,pageFor,ogPath,structuredData,llmLd,url } from '../lib/site-content.mjs';
const page=pageFor(Astro.url.pathname);
const head=Astro.locals.starlightRoute.head;
const setMeta=(key:string,name:string,content:string)=>{
  for(let i=head.length-1;i>=0;i--){const t=head[i];if(t.tag==='meta'&&t.attrs?.[key]===name)head.splice(i,1);}
  head.push({tag:'meta',attrs:{[key]:name,content}});
};
if(page){
  const image=site+ogPath(page.path),title=page.path==='/'?page.title:page.title+' · '+brand;
  const titleTag=head.find(t=>t.tag==='title');if(titleTag)titleTag.content=title;
  setMeta('name','description',page.description);
  for(const [key,value] of Object.entries({'og:title':title,'og:description':page.description,'og:url':url(page.path),'og:site_name':brand,'og:type':'website','og:locale':'ru_RU','og:image':image,'og:image:type':'image/png','og:image:width':'1200','og:image:height':'630','og:image:alt':page.title+' — Масляница в Белграде'}))setMeta('property',key,value);
  for(const [key,value] of Object.entries({'twitter:card':'summary_large_image','twitter:title':title,'twitter:description':page.description,'twitter:image':image,'twitter:image:alt':page.title}))setMeta('name',key,value);
}
const json=(value:unknown)=>JSON.stringify(value).replace(/</g,'\\u003c');
---
<!-- Capture Telegram's launch theme before router/other scripts can change the hash.
     No request to Telegram in an ordinary browser. The adapter owns live synchronization. -->
<script is:inline>
  (() => {
    if (window.__masljanicaTelegramLaunch) return;
    try {
      const url = new URL(location.href);
      for (const raw of [url.hash.slice(1), url.search.slice(1)]) {
        const p = new URLSearchParams(raw);
        const platform = p.get('tgWebAppPlatform'), version = p.get('tgWebAppVersion');
        if (!/^[a-z][a-z0-9_]{1,23}$/i.test(platform || '') || platform === 'unknown' ||
            !/^\d+(?:\.\d+){0,3}$/.test(version || '') ||
            (!p.has('tgWebAppData') && !p.has('tgWebAppThemeParams'))) continue;
        let theme = null, colors = {};
        try {
          const rawColors = JSON.parse(p.get('tgWebAppThemeParams') || '{}');
          for (const [key,value] of Object.entries(rawColors)) if (/^[a-z_]+_color$/.test(key) && typeof value === 'string' && /^#[0-9a-f]{6}$/i.test(value)) colors[key]=value.toLowerCase();
          const bg = colors.bg_color;
          if (/^#[0-9a-f]{6}$/i.test(bg || '')) {
            const [r,g,b] = bg.slice(1).match(/../g).map(x => parseInt(x,16));
            theme = r*.299+g*.587+b*.114 < 128 ? 'dark' : 'light';
          }
        } catch {}
        window.__masljanicaTelegramLaunch = {platform, version, theme, colors};
        // Apply launch colors before the deferred runtime/SDK; no wait for a theme event.
        let mode='auto';try{mode=localStorage.getItem('starlight-theme')||'auto';}catch{}
        if(mode!=='light'&&mode!=='dark'&&colors.bg_color){
          const root=document.documentElement;
          for(const [key,value] of Object.entries(colors))root.style.setProperty('--masljanica-tg-'+key.replaceAll('_','-'),value);
          root.dataset.telegramPalette='active';
        }
        if (!window.Telegram?.WebApp && !document.querySelector('script[data-telegram-bridge]')) {
          const script = document.createElement('script');
          script.src = 'https://telegram.org/js/telegram-web-app.js?65';
          script.async = true;
          script.dataset.telegramBridge = '';
          document.head.append(script);
        }
        break;
      }
    } catch {}
  })();
</script>
<Head />
<!-- Dark launch fallback; apply the saved/system/Telegram theme before the first paint. -->
<script is:inline>
  (() => {
    const root=document.documentElement;
    const meta=document.querySelector('meta[name="theme-color"]');
    if(!meta)return;
    let mode='auto';try{mode=localStorage.getItem('starlight-theme')||'auto';}catch{}
    const launch=window.__masljanicaTelegramLaunch;
    const explicit=mode==='light'||mode==='dark';
    const theme=explicit?mode:(launch?.theme||root.dataset.theme||(matchMedia('(prefers-color-scheme: light)').matches?'light':'dark'));
    const bg=!explicit&&launch?.colors?.bg_color;
    meta.content=bg|| (theme==='light'?'#FFFFFF':'#101827');
  })();
</script>
{page && <script type="application/ld+json" id="masljanica-schema" set:html={json(structuredData(page))} />}
{page?.path==='/' && <script type="application/ld+json" id="masljanica-llmld" set:html={json(llmLd)} />}
<ClientRouter fallback="swap" />
