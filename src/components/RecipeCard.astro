---
import GameIcon from './GameIcon.astro';
const {recipe}=Astro.props;
---
<details class="recipe-card" id={recipe.id}>
  <summary><span class="recipe-number">{recipe.number}</span><strong>{recipe.title}</strong><GameIcon name="chevron"/></summary>
  <div class="recipe-method"><p>{recipe.method}</p><small>Издание 1854 г., с. {recipe.pages} · <a href={'/pancakes/'+recipe.id+'/'}>Отдельный рецепт</a></small></div>
</details>
<style>
.recipe-card{margin:0!important;border:1px solid var(--sl-color-gray-5);border-radius:.7rem;background:var(--festival-surface)}
.recipe-card summary{display:grid;grid-template-columns:1.6rem minmax(0,1fr) 1rem;align-items:center;gap:.6rem;padding:.7rem .8rem;cursor:pointer;list-style:none;font-size:.9rem}
.recipe-card summary::-webkit-details-marker{display:none}.recipe-card summary::before{display:none}
.recipe-number{color:var(--sl-color-text-accent);font-variant-numeric:tabular-nums;font-weight:650}
.recipe-card summary :global(svg){width:1rem;height:1rem;color:var(--sl-color-text-accent)}.recipe-card[open] summary :global(svg){transform:rotate(180deg)}
.recipe-method{padding:0 .8rem .75rem}.recipe-method p{margin:0 0 .5rem!important;color:var(--sl-color-text)!important;line-height:1.6}.recipe-method small{font-size:.75rem;color:var(--sl-color-gray-3)}
</style>
