---
import {localize} from '../lib/editorial-i18n.mjs';
const {tx,lp,uiLocale,uiTag}=localize(Astro.url.pathname);
import StoryMusic from './StoryMusic.astro';
import HistoryFigure from './HistoryFigure.astro';
import songs from '../data/songs.json';
import games from '../data/games.json';
import archive from '../data/audio-archive.json';
import media from '../data/history-media.json';
import {existsSync} from 'node:fs';
const {chapter}=Astro.props;
const files=archive.files as Record<string,{path:string;duration:number}>;
const musical=(chapter.songs||[]).map((slug:string)=>{
  const song=songs.find(x=>x.slug===slug);if(!song)throw Error('Unknown history song '+slug);
  const tracks=song.audio.map(url=>{const t=files[url];if(!t||!existsSync(process.cwd()+'/public'+t.path))throw Error('Missing history audio '+url);return {src:t.path,duration:t.duration};});
  return {song,tracks,row:{order:chapter.id+'-'+slug}};
});
const playful=(chapter.games||[]).map((slug:string)=>{const game=games.find(x=>x.slug===slug);if(!game)throw Error('Unknown history game '+slug);return game;});
const pictures=(chapter.images||[]).map((id:string)=>{const img=media.find(x=>x.id===id);if(!img)throw Error('Unknown history image '+id);return img;});
---
<section class="history-chapter" aria-labelledby={chapter.id}>
  <h2 id={chapter.id} class="history-chapter-title">{tx(chapter.title)}</h2>
  <div class="history-chapter-body">
    {chapter.paragraphs.map((paragraph:string)=><p lang={uiLocale!=='ru'&&tx(paragraph)===paragraph?'ru':uiTag}>{tx(paragraph)}</p>)}
    {pictures.map(item=><HistoryFigure item={item}/>)}
    {musical.map(item=><StoryMusic {...item}/>)}
    {playful.length>0 && <div class="history-links"><span>{tx("Попробуйте на нашем празднике")}</span>{playful.map(game=><a class="history-game-link" href={lp('/games/#'+game.slug)}>{tx(game.title)} →</a>)}</div>}
    {(chapter.links||[]).map((link:{href:string;title:string})=><a class="history-related" href={lp(link.href)}>{tx(link.title)} →</a>)}
    <p><a href={lp('/history/'+chapter.id+'/')}>{tx("Читать отдельную статью →")}</a> · <a href={lp("/sources/")}>{tx("Источники")}</a></p>
    <small class="history-source">{tx('По источникам: ')}{chapter.source}.</small>
  </div>
</section>
<style>
.history-chapter{min-width:0;margin:0!important}.history-chapter-title{font-size:1.4rem;line-height:1.3;font-weight:650;margin:0 0 .85rem!important;scroll-margin-top:0}
.history-chapter-body{display:grid;gap:.75rem;padding:0;min-width:0}.history-chapter-body p{margin:0!important;line-height:1.65}.history-chapter-body :global(.story-music){margin:0!important}.history-links{display:flex;flex-wrap:wrap;gap:.4rem;margin:0!important}.history-links span{flex-basis:100%;font-size:.8rem;font-weight:600;color:var(--sl-color-gray-3)}.history-links a,.history-related{color:var(--sl-color-text-accent);font-size:.85rem;overflow-wrap:anywhere;margin:0!important}.history-links a{padding:.35rem .5rem;border:1px solid var(--sl-color-gray-5);border-radius:.45rem;text-decoration:none}.history-source{color:var(--sl-color-gray-3);font-size:.75rem;line-height:1.45}
</style>
