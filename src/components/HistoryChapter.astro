---
import GameIcon from './GameIcon.astro';
import StoryMusic from './StoryMusic.astro';
import HistoryFigure from './HistoryFigure.astro';
import songs from '../data/songs.json';
import games from '../data/games.json';
import archive from '../data/audio-archive.json';
import media from '../data/history-media.json';
import {existsSync} from 'node:fs';
const {chapter,number}=Astro.props;
const files=archive.files as Record<string,{path:string;duration:number}>;
const musical=(chapter.songs||[]).map((slug:string)=>{
  const song=songs.find(x=>x.slug===slug);if(!song)throw Error('Unknown history song '+slug);
  const tracks=song.audio.map(url=>{const t=files[url];if(!t||!existsSync(process.cwd()+'/public'+t.path))throw Error('Missing history audio '+url);return {src:t.path,duration:t.duration};});
  return {song,tracks,row:{order:chapter.id+'-'+slug}};
});
const playful=(chapter.games||[]).map((slug:string)=>{const game=games.find(x=>x.slug===slug);if(!game)throw Error('Unknown history game '+slug);return game;});
const pictures=(chapter.images||[]).map((id:string)=>{const img=media.find(x=>x.id===id);if(!img)throw Error('Unknown history image '+id);return img;});
---
<details class="history-chapter story-part" open={number===1}>
  <summary><span class="story-part-number">{number}</span><h2 id={chapter.id} class="history-chapter-title">{chapter.title}</h2><GameIcon name="chevron" class="story-chevron"/></summary>
  <div class="history-chapter-body">
    {chapter.paragraphs.map((paragraph:string)=><p>{paragraph}</p>)}
    {pictures.map(item=><HistoryFigure item={item}/>)}
    {musical.map(item=><StoryMusic {...item}/>)}
    {playful.length>0 && <div class="history-links"><span>Попробуйте на нашем празднике</span>{playful.map(game=><a class="history-game-link" href={'/games/#'+game.slug}>{game.title} →</a>)}</div>}
    {(chapter.links||[]).map((link:{href:string;title:string})=><a class="history-related" href={link.href}>{link.title} →</a>)}
    <small class="history-source">По источникам: {chapter.source}.</small>
  </div>
</details>
<style>
.history-chapter{scroll-margin-top:0;margin:0!important}.history-chapter-title{font-size:inherit!important;line-height:1.35;font-weight:650;margin:0!important;scroll-margin-top:0}
.history-chapter-body{display:grid;gap:.75rem;padding:.25rem .85rem 1rem;min-width:0}.history-chapter-body p{margin:0!important;line-height:1.65}.history-chapter-body :global(.story-music){margin:0!important}.history-links{display:flex;flex-wrap:wrap;gap:.4rem;margin:0!important}.history-links span{flex-basis:100%;font-size:.8rem;font-weight:600;color:var(--sl-color-gray-3)}.history-links a,.history-related{color:var(--sl-color-text-accent);font-size:.85rem;overflow-wrap:anywhere;margin:0!important}.history-links a{padding:.35rem .5rem;border:1px solid var(--sl-color-gray-5);border-radius:.45rem;text-decoration:none}.history-source{color:var(--sl-color-gray-3);font-size:.75rem;line-height:1.45}
</style>
