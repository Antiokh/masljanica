---
import characters from '../data/characters.json';
import archive from '../data/character-archive.json';
import { existsSync } from 'node:fs';
type Archived={path:string; width:number; height:number};
const files=archive.files as Record<string,Archived>;
const people=characters.filter(x=>x.show).map(x=>{
  const file=files[x.image];
  const src=file?.path && /^\/media\/characters\/[a-f0-9]+\.webp$/.test(file.path) && existsSync(process.cwd()+'/public'+file.path) ? file.path : '';
  return {...x,src};
});
---
<div class="home-character-grid" data-character-gallery>
  {people.map(x=><button type="button" class="home-character-card" data-character-open={x.slug} aria-haspopup="dialog" aria-controls={'character-'+x.slug}>
    <span class="home-character-art" aria-hidden="true">{x.src?<img src={x.src} alt="" width={files[x.image]?.width||640} height={files[x.image]?.height||640} decoding="async"/>:<span>{x.title.slice(0,1)}</span>}</span>
    <strong>{x.title}</strong>
  </button>)}
  {people.map(x=><dialog class="character-dialog" id={'character-'+x.slug} aria-labelledby={'character-title-'+x.slug} data-character-dialog>
    <div class="character-dialog-inner">
      <button type="button" class="character-dialog-close" data-character-close aria-label="Закрыть" autofocus><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"/></svg></button>
      {x.src && <img class="character-dialog-art" src={x.src} alt="" loading="lazy" decoding="async"/>}
      <h2 id={'character-title-'+x.slug}>{x.title}</h2>
      {x.description.split(/\n\s*\n/).map(text=><p>{text}</p>)}
    </div>
  </dialog>)}
</div>
