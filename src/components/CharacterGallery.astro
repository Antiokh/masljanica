---
import {localize} from '../../public/i18n.mjs';
const {tx,lp,uiLocale,uiTag}=localize(Astro.url.pathname);
import characters from '../data/characters.json';
import archive from '../data/character-archive.json';
import { existsSync } from 'node:fs';
type Archived={path:string; width:number; height:number};
const files=archive.files as Record<string,Archived>;
const people=characters.map(x=>{
  const file=files[x.image];
  const src=file?.path && /^\/media\/characters\/[a-f0-9]+\.webp$/.test(file.path) && existsSync(process.cwd()+'/public'+file.path) ? file.path : '';
  return {...x,src};
});
---
<div class="character-gallery-disclosure" data-character-disclosure>
<div class="home-character-grid" id="story-character-grid">
  {people.map(x=><button type="button" class="home-character-card" data-character-open={x.slug} aria-haspopup="dialog" aria-controls={'character-'+x.slug}>
    <span class="home-character-art" aria-hidden="true">{x.src?<img src={x.src} alt="" width={files[x.image]?.width||640} height={files[x.image]?.height||640} decoding="async"/>:<span>{x.title.slice(0,1)}</span>}</span>
    <strong>{tx(x.title)}</strong>
  </button>)}
</div>
{people.length>5 && <button type="button" class="character-gallery-toggle" data-character-toggle aria-controls="story-character-grid" aria-expanded="false" hidden>
  <span data-character-more>{tx('Ещё ')}{people.length-5}{tx(' персонажа')}</span><span data-character-less hidden>{tx("Свернуть")}</span>
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
</button>}
</div>
