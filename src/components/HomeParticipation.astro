---
import {participation} from '../lib/knowledge-content.mjs';
const {socials}=Astro.props;
---
<section class="home-participation" id="join" aria-labelledby="home-join-title">
  <h2 id="home-join-title">{participation.title}</h2>
  <p>{participation.intro}</p>
  <ul class="participation-roles">
    {participation.roles.map(([title,description])=><li><strong>{title}</strong><span>{description}</span></li>)}
  </ul>
  <p>{participation.outro}</p>
  <nav class="participation-contacts" aria-label="Связь с командой" data-online-only hidden>
    {socials.map(social=><a href={social.href} target="_blank" rel="noopener noreferrer">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={social.path}/></svg><span>{social.name}</span>
    </a>)}
  </nav>
  <p class="participation-offline">Контакты: {socials.map((social,i)=><>{i>0?' · ':''}{social.href.replace(/^https:\/\//,'')}</>)}</p>
</section>
<style>
 .home-participation{min-width:0;padding:1rem;border:1px solid var(--sl-color-gray-5);border-inline-start:3px solid var(--sl-color-accent);border-radius:.85rem;background:var(--festival-surface);scroll-margin-top:5rem;overflow-wrap:anywhere}
 .home-participation h2{color:var(--sl-color-text-accent);font-size:1.15rem;line-height:1.35;margin:0 0 .65rem!important}
 .home-participation p{margin:.6rem 0!important;line-height:1.55}
 .participation-roles{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,15rem),1fr));gap:.65rem 1rem;list-style:none;padding:0;margin:.9rem 0!important}
 .participation-roles li{min-width:0;display:grid;gap:.15rem;margin:0!important;line-height:1.45;font-size:.88rem}
 .participation-roles strong{color:var(--sl-color-text);font-weight:650}
 .participation-roles span{color:var(--sl-color-gray-2)}
 .participation-contacts{display:flex;flex-wrap:wrap;gap:.45rem;margin:.8rem 0 0!important}
 .participation-contacts[hidden]{display:none!important}
 .participation-contacts a{display:inline-flex;align-items:center;gap:.35rem;border:1px solid var(--sl-color-gray-5);border-radius:.6rem;padding:.45rem .65rem;font-size:.85rem;text-decoration:none;color:var(--sl-color-text-accent);margin:0!important}
 .participation-contacts a:hover{border-color:var(--sl-color-accent)}
 .participation-contacts svg{width:1.1rem;height:1.1rem;flex:none;margin:0!important}
 .participation-offline{display:none;color:var(--sl-color-gray-3);font-size:.8rem}
 .participation-contacts[hidden]+.participation-offline{display:block}
</style>
