---
import {localize} from '../../public/i18n.mjs';
const {tx,lp,uiLocale,uiTag}=localize(Astro.url.pathname);
const {row,song,tracks}=Astro.props;
const format=(n:number)=>Math.floor(n/60)+':'+String(Math.floor(n%60)).padStart(2,'0');
---
<div class="story-music" data-story-music={row.order} data-tracks={JSON.stringify(tracks)}>
                    <div class="story-music-top">
                      <button type="button" class="story-play" data-story-action="toggle" data-playing="false" aria-label={tx('Воспроизвести: ')+song.title}>
                        <svg viewBox="0 0 40 40" class="story-ring" aria-hidden="true"><circle cx="20" cy="20" r="17" class="story-ring-track"/><circle cx="20" cy="20" r="17" pathLength="100" class="story-ring-progress"/></svg>
                        <svg viewBox="0 0 24 24" class="story-play-icon" fill="currentColor" aria-hidden="true"><path d="M8 5v14l12-7z"/></svg><svg viewBox="0 0 24 24" class="story-pause-icon" fill="currentColor" aria-hidden="true"><path d="M7 5h4v14H7zm6 0h4v14h-4z"/></svg>
                      </button>
                      <div class="story-music-main"><strong>{tx(song.title)}</strong><div class="story-seek-row"><input type="range" class="story-seek" min="0" max="1000" step="1" value="0" aria-label={tx('Перемотка: ')+song.title}/><span class="story-time">{format(tracks[0].duration)}</span></div></div>
                    </div>
                    {tracks.length>1&&<div class="story-variants" role="group" aria-label={tx("Варианты исполнения")}>{tracks.map((_,i)=><button type="button" data-story-variant={i} aria-pressed={i===0?'true':'false'} aria-label={tx('Запись ')+(i+1)}>{i+1}</button>)}</div>}
                    <a class="story-song-link" href={lp('/songs/#'+song.slug)}>{tx("Текст в песеннике")}</a>
                    <p class="story-music-error" role="status" hidden></p>
                  </div>
